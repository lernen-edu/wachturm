# Wachturm — environment variable template
#
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored and MUST NOT be committed (AGENTS.md §6.3).
# This `.env.example` contains placeholders only — no real secrets.
#
# Every variable below has a safe default baked into docker-compose.yml,
# so the stack will *start* without a `.env`. But the defaults are
# deliberately insecure ("changeme_in_env"); before running anything you
# care about, copy this file and replace every value marked CHANGE_ME.
#
# Generate strong random secrets with:
#
#     openssl rand -hex 32
#
# ─────────────────────────────────────────────────────────────────────
# Core profile (Phase 1) — Wazuh, victims, attacker, noise, portal
# ─────────────────────────────────────────────────────────────────────

# Deterministic seed for the benign-noise generator. Keeping this fixed
# makes scenario runs reproducible. Any integer; 42 is fine to leave.
NOISE_SEED=42

# Host port for the Wazuh dashboard (loopback only). Default 8443.
# Override if 8443 is already taken on your machine — some local Docker
# backends (Lima, Colima, Docker Desktop) bind 127.0.0.1:8443 themselves.
# `make doctor` will flag a conflict; pick any free port, e.g. 8444.
WAZUH_DASHBOARD_PORT=8443

# ─────────────────────────────────────────────────────────────────────
# casemgmt profile (Phase 2) — DFIR-IRIS + Cortex
# Not used until Phase 2 brings these services online, but set them now
# so a later `make up-casemgmt` doesn't run on insecure defaults.
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL account backing DFIR-IRIS.
IRIS_DB_USER=iris
IRIS_DB_PASSWORD=CHANGE_ME_iris_db_password

# DFIR-IRIS Flask secret key. Generate: openssl rand -hex 32
IRIS_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

# DFIR-IRIS password salt (maps to IRIS_SECURITY_PASSWORD_SALT).
# Generate: openssl rand -hex 32
IRIS_PW_SALT=CHANGE_ME_run_openssl_rand_hex_32

# Initial DFIR-IRIS administrator password (first-boot only; the UI
# forces a change on first login).
IRIS_ADM_PASSWORD=CHANGE_ME_iris_admin_password

# Cortex Play application secret. Generate: openssl rand -hex 32
# (config/cortex/application.conf reads this; a safe-but-insecure
# sealed-lab default is baked in so the stack still starts without it.)
CORTEX_PLAY_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# AbuseIPDB analyzer API key — OPTIONAL. Phase 2 ships keyless analyzers
# (MaxMind GeoIP, MISP warning lists) that work out of the box with no
# account. AbuseIPDB's free tier (1000 req/day) needs a personal key
# from https://www.abuseipdb.com/account/api . Leave this unset and the
# AbuseIPDB analyzer is simply not enabled — nothing else is affected.
# Set it (here, then `make up-casemgmt`) to enable IP reputation lookups
# inside Cortex. Result caching (10 min) protects the daily quota.
ABUSEIPDB_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# intel profile (Phase 4) — MISP
# Deferred to Phase 4; documented here for completeness.
# ─────────────────────────────────────────────────────────────────────

# MariaDB application + root passwords for MISP.
MISP_DB_PASSWORD=CHANGE_ME_misp_db_password
MISP_DB_ROOT_PASSWORD=CHANGE_ME_misp_db_root_password

# ─────────────────────────────────────────────────────────────────────
# Optional image-version pins (reserved)
# ─────────────────────────────────────────────────────────────────────
# docker-compose.yml currently hard-pins image versions inline. These
# variables are reserved for future env-driven pinning; they are NOT
# interpolated yet, so setting them has no effect today. Documented so
# the eventual switch to `${WAZUH_VERSION}` etc. is discoverable.
#
# WAZUH_VERSION=4.9.2
# IRIS_VERSION=v2.4.20
